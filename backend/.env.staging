# 预发布环境配置
ENV=staging

# 数据库配置
DB_HOST=staging-db-server
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=staging_password
DB_NAME=ai_agent_platform_staging

# JWT配置
SECRET_KEY=staging_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS配置 - 前端域名（多个用逗号分隔）
ALLOWED_ORIGINS=http://localhost:5173,https://staging.yourdomain.com
