    {
      "parameters": {
        "jsCode": "// n8n Webhook -> Code 节点\nconst body = $json.body;\n\n// AI 回复统一格式（异常用）\nfunction aiReply(message) {\n  return [\n    {\n      json: {\n        success: false,   // 👈 显式 false\n        output: message\n      }\n    }\n  ];\n}\n\n// 从用户输入中提取邮箱\nfunction extractEmail(text) {\n  if (!text || typeof text !== 'string') return null;\n  const match = text.match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/i);\n  return match ? match[0] : null;\n}\n\n// 1️⃣ 没有收到 body → 拦截\nif (!body || typeof body !== 'object') {\n  return aiReply(\n    '您好，我是 AI 每日简报助手 🙂\\n请告诉我需要发送到哪个邮箱。'\n  );\n}\n\n// 2️⃣ 没有 message → 拦截\nif (!body.message) {\n  return aiReply(\n    '您好，我是 AI 每日简报助手。\\n请直接告诉我收件人的邮箱地址，例如：\\n收件人邮箱：example@email.com'\n  );\n}\n\n// 3️⃣ 从 message 中抽取邮箱\nconst email = extractEmail(body.message);\n\n// 4️⃣ 没抽到邮箱 → 拦截\nif (!email) {\n  return aiReply(\n    '您好，我是 AI 每日简报助手。\\n我还没有识别到收件人的邮箱地址，请再告诉我一次，例如：\\n收件人邮箱：example@email.com'\n  );\n}\n\n// ✅ 5️⃣ 成功：放行\nreturn [\n  {\n    json: {\n      success: true,        // 👈 显式 true\n      email,                // 给后面用\n      user: body.user || {},// 可选\n      source: 'daily_brief' // 可选\n    }\n  }\n];\n"
      },
