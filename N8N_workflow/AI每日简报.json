    {
      "parameters": {
        "html": "<!DOCTYPE html>\n<html>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>今日 AI 新闻简报</title>\n  </head>\n\n  <body style=\"margin:0; padding:0; background-color:#fafafa;\">\n    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#fafafa;\">\n      <tr>\n        <td align=\"center\" style=\"padding:30px;\">\n\n          <!-- 主容器 -->\n          <table width=\"680\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#ffffff; border-radius:8px;\">\n            \n            <!-- 标题 -->\n            <tr>\n              <td style=\"padding:20px 20px 10px 20px;\">\n                <div style=\"font-size:22px; font-weight:bold; color:#2a5bd7;\">\n                  📰 今日 AI 新闻简报\n                </div>\n                <div style=\"height:3px; background-color:#2a5bd7; margin-top:8px;\"></div>\n              </td>\n            </tr>\n\n            <!-- 正文内容 -->\n            <tr>\n              <td style=\"padding:20px; font-size:15px; line-height:1.8; color:#333333; text-align:left;\">\n                {{ $json.output.replace(/\\n/g, '<br/>') }}\n              </td>\n            </tr>\n\n          </table>\n\n          <!-- 页脚 -->\n          <table width=\"680\" cellpadding=\"0\" cellspacing=\"0\">\n            <tr>\n              <td style=\"padding-top:20px; font-size:12px; color:#666666; text-align:left;\">\n                新闻来源：Google News · 中文新闻聚合<br/>\n                本简报由 <strong>Nexus AI</strong> 自动整理生成<br/>\n                {{ new Date().toLocaleString(\"zh-CN\", { timeZone: \"Asia/Shanghai\" }) }}\n              </td>\n            </tr>\n          </table>\n\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>\n"
