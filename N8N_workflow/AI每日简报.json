      "parameters": {
        "jsCode": "// 把所有新闻项合并成一条输入\nconst combined = items.map(item => {\n  const d = item.json;\n  return `【標題】${d.title}\\n【時間】${d.date}\\n【摘要】${d.summary}\\n【來源】${d.link}`;\n}).join('\\n\\n');\n\nreturn [{\n  json: {\n    all_news: combined,\n    count: items.length\n  }\n}];\n"
      },
