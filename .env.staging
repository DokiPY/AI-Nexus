# ============================================
# 预发布环境 Docker Compose 配置
# 用法: docker compose --env-file .env.staging up -d --build
# ============================================

# 环境标识
ENV=staging
VITE_ENV=staging

# 数据库配置（替换为实际值）
DB_HOST=your-staging-db-host
DB_PORT=5432
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=ai_agent_platform

# JWT（替换为实际密钥）
SECRET_KEY=your-staging-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS（替换为实际域名）
ALLOWED_ORIGINS=https://staging.your-domain.com

# 应用配置
DEBUG=true
