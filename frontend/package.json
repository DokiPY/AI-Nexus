{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:prod": "VITE_ENV=production vue-tsc -b && vite build",
    "build:staging": "VITE_ENV=staging vue-tsc -b && vite build",
    "build:test": "VITE_ENV=test vue-tsc -b && vite build",
    "preview": "vite preview --outDir dist-local",
    "preview:prod": "VITE_ENV=production vite preview --outDir dist-production",
    "preview:staging": "VITE_ENV=staging vite preview --outDir dist-staging",
    "preview:test": "VITE_ENV=test vite preview --outDir dist-test"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "dotenv": "^17.2.3",
    "echarts": "^6.0.0",
    "element-plus": "^2.11.9",
    "highlight.js": "^11.11.1",
    "lucide-vue-next": "^0.561.0",
    "marked": "^17.0.1",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.1.4"
  }
}

